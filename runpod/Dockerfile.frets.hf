FROM python:3.12-slim

ARG RUNPOD_VERSION=1.12.0
ARG HUGGINGFACE_HUB_VERSION=1.32.0
RUN test -n "$RUNPOD_VERSION" && test -n "$HUGGINGFACE_HUB_VERSION"
COPY runpod/requirements-frets.txt /tmp/requirements-frets.txt
RUN python -m pip install --no-cache-dir "runpod==${RUNPOD_VERSION}" \
    "huggingface_hub==${HUGGINGFACE_HUB_VERSION}" -r /tmp/requirements-frets.txt

WORKDIR /app
COPY runpod/common.py runpod/frets_worker.py /app/
# Runtime: MIDI2FRETS_HF_REPO, pinned MIDI2FRETS_HF_REVISION, and HF_TOKEN.
CMD ["python", "frets_worker.py"]
