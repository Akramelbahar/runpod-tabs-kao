FROM python:3.12-slim

ARG RUNPOD_VERSION=1.12.0
RUN test -n "$RUNPOD_VERSION"
COPY runpod/requirements-frets.txt /tmp/requirements-frets.txt
RUN python -m pip install --no-cache-dir "runpod==${RUNPOD_VERSION}" -r /tmp/requirements-frets.txt

WORKDIR /app
COPY runpod/common.py runpod/frets_worker.py /app/
# Attach the private model volume at /runpod-volume before starting workers.
CMD ["python", "frets_worker.py"]
